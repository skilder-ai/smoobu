{
  "name": "@skilder-ai/smoobu",
  "version": "0.1.1",
  "description": "Typed Smoobu API client (HMAC-signed requests, validated responses, clean domain model).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skilder-ai/smoobu.git",
